import React, { useState } from 'react';
import { usePromoIQ } from '../context/PromoIQContext';
import { 
  UploadCloud, 
  FileText, 
  CheckCircle2, 
  AlertCircle, 
  Layers, 
  Play, 
  Database 
} from 'lucide-react';

export const ScreenplayUploader: React.FC = () => {
  const { uploadFiles, loadSampleData, episodes, runAnalysisOnEpisodes, isAnalyzing, setActiveTab } = usePromoIQ();
  const [dragActive, setDragActive] = useState<boolean>(false);
  const [uploadedFilesCount, setUploadedFilesCount] = useState<number>(0);

  const handleDrag = (e: React.DragEvent) => {
    e.preventDefault();
    e.stopPropagation();
    if (e.type === 'dragenter' || e.type === 'dragover') {
      setDragActive(true);
    } else if (e.type === 'dragleave') {
      setDragActive(false);
    }
  };

  const handleDrop = async (e: React.DragEvent) => {
    e.preventDefault();
    e.stopPropagation();
    setDragActive(false);
    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
      const filesArray = Array.from(e.dataTransfer.files);
      setUploadedFilesCount(filesArray.length);
      await uploadFiles(filesArray);
    }
  };

  const handleFileInput = async (e: React.ChangeEvent<HTMLInputElement>) => {
    if (e.target.files && e.target.files.length > 0) {
      const filesArray = Array.from(e.target.files);
      setUploadedFilesCount(filesArray.length);
      await uploadFiles(filesArray);
    }
  };

  return (
    <div className="max-w-4xl mx-auto space-y-6 pb-12">
      <div>
        <h2 className="text-xl font-bold text-gray-900">Screenplay Upload & Parsing Engine</h2>
        <p className="text-xs text-gray-500 mt-1">
          Upload individual TXT screenplays, batch CSVs, or Fountain files with timestamp brackets.
        </p>
      </div>

      {/* Drag & Drop Area */}
      <div
        onDragEnter={handleDrag}
        onDragLeave={handleDrag}
        onDragOver={handleDrag}
        onDrop={handleDrop}
        className={`relative border-2 border-dashed rounded-2xl p-10 text-center transition ${
          dragActive
            ? 'border-violet-600 bg-violet-50/50'
            : 'border-gray-300 hover:border-gray-400 bg-white'
        }`}
      >
        <input
          type="file"
          id="screenplay-upload-input"
          multiple
          accept=".txt,.csv,.json"
          onChange={handleFileInput}
          className="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
        />

        <div className="flex flex-col items-center pointer-events-none">
          <div className="w-14 h-14 bg-violet-50 text-violet-600 rounded-2xl flex items-center justify-center mb-4 shadow-sm">
            <UploadCloud className="w-7 h-7" />
          </div>
          <h3 className="text-base font-semibold text-gray-900">
            Drag & drop timestamped screenplay files here
          </h3>
          <p className="text-xs text-gray-500 max-w-md mt-1 mb-4">
            Supported formats: <strong className="text-gray-700">.TXT</strong> with `[MM:SS.ms]` timestamps, <strong className="text-gray-700">.CSV</strong> (Timestamp_Start, Timestamp_End, Character, Dialogue), and Fountain transcripts.
          </p>

          <span className="inline-flex items-center px-4 py-2 rounded-lg bg-gray-100 text-gray-700 text-xs font-semibold hover:bg-gray-200">
            Browse Local Files
          </span>
        </div>
      </div>

      {/* Or Load Pre-Configured Samples */}
      <div className="bg-gray-50 border border-gray-200 rounded-xl p-4 flex items-center justify-between">
        <div className="flex items-center space-x-3">
          <div className="w-9 h-9 rounded-lg bg-white border border-gray-200 flex items-center justify-center text-violet-600">
            <Database className="w-4 h-4" />
          </div>
          <div>
            <h4 className="text-xs font-bold text-gray-900">Need instant test data?</h4>
            <p className="text-xs text-gray-500">Load sample Kuku microdrama episodes (*The Billionaire's Secret Heir*).</p>
          </div>
        </div>
        <button
