          <button
            onClick={exportAsJSON}
            className="flex items-center space-x-1.5 px-3 py-1.5 bg-white border border-gray-300 text-gray-700 rounded-lg text-xs font-semibold hover:bg-gray-50 transition"
          >
            <Download className="w-3.5 h-3.5" />
