          <h3 className="text-2xl font-bold text-gray-900 mt-1">{approved} <span className="text-xs font-normal text-gray-400">Approved</span></h3>
          <p className="text-xs text-gray-500 mt-1">{pending} pending • {rejected} rejected</p>
