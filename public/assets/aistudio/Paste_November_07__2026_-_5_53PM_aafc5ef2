import React from 'react';
import { usePromoIQ } from '../context/PromoIQContext';
import { 
  ShieldCheck, 
  CheckCircle2, 
  AlertTriangle, 
  XCircle, 
  X, 
  Clock, 
  Flame, 
  FileCheck2 
} from 'lucide-react';

export const QualityCheckModal: React.FC = () => {
  const { activeQCPromo, setActiveQCPromo } = usePromoIQ();

  if (!activeQCPromo) return null;

  const promo = activeQCPromo;

  // QC Checklist Evaluation
  const checks = [
    {
      title: 'Duration Window (20s - 60s)',
      passed: promo.duration_seconds >= 20 && promo.duration_seconds <= 60,
      detail: `Current duration: ${promo.duration_seconds}s. Perfect for TikTok/Shorts vertical retention.`,
      critical: true
    },
    {
      title: '3-Second Opening Hook Impact',
      passed: promo.hook_score >= 70,
      detail: `Hook Score: ${promo.hook_score}/100. Evaluates instant dialogue conflict or physical action hook.`,
      critical: true
    },
    {
      title: 'Unresolved Cliffhanger Finale',
      passed: promo.cliffhanger_score >= 70,
      detail: `Cliffhanger Score: ${promo.cliffhanger_score}/100. Ensures viewers must tap to watch the full episode.`,
      critical: true
    },
    {
      title: 'Standalone Narrative Comprehension',
      passed: promo.standalone_clarity >= 70,
      detail: `Clarity Score: ${promo.standalone_clarity}/100. First-time viewer can follow without context.`,
      critical: false
    },
    {
      title: 'Screenplay Verbatim Integrity',
      passed: true,
      detail: 'Timestamp markers and dialogue match actual screenplay line indices.',
      critical: true
    },
    {
      title: 'Dialogue Friction & Multiple Speakers',
      passed: promo.dialogue_snippets.length >= 2,
      detail: `Contains ${promo.dialogue_snippets.length} continuous screenplay turns.`,
      critical: false
    }
  ];

  const totalPassed = checks.filter(c => c.passed).length;
  const passedAllCritical = checks.filter(c => c.critical).every(c => c.passed);

  return (
    <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-white w-full max-w-2xl rounded-2xl shadow-2xl border border-gray-200 overflow-hidden animate-in fade-in zoom-in-95 duration-200">
        {/* Header */}
        <div className="p-5 border-b border-gray-100 flex items-center justify-between bg-gray-50/70">
          <div className="flex items-center space-x-2.5">
            <div className="w-8 h-8 rounded-lg bg-violet-100 text-violet-700 flex items-center justify-center font-bold">
              <ShieldCheck className="w-5 h-5" />
            </div>
            <div>
              <h3 className="font-bold text-gray-900 text-base">Quality Control Audit</h3>
              <p className="text-xs text-gray-500">Episode {promo.episode} • {promo.start_timestamp} - {promo.end_timestamp}</p>
            </div>
          </div>
          <button 
            onClick={() => setActiveQCPromo(null)}
            className="p-1 rounded-lg hover:bg-gray-200 text-gray-400 hover:text-gray-700"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Content Body */}
        <div className="p-6 space-y-5 max-h-[75vh] overflow-y-auto">
          {/* Status Verdict */}
          <div className={`p-4 rounded-xl border flex items-center justify-between ${
            passedAllCritical ? 'bg-emerald-50/60 border-emerald-200 text-emerald-900' : 'bg-amber-50/60 border-amber-200 text-amber-900'
          }`}>
            <div>
              <h4 className="font-bold text-sm">
                {passedAllCritical ? 'Passed Studio QC Standards' : 'QC Warnings Detected'}
              </h4>
              <p className="text-xs opacity-80 mt-0.5">
                {totalPassed} of {checks.length} compliance checkpoints satisfied.
              </p>
            </div>
            <div className="text-2xl font-black">
              {Math.round((totalPassed / checks.length) * 100)}%
            </div>
          </div>

          {/* Audit Checklist */}
          <div className="space-y-3">
            <h4 className="text-xs font-semibold text-gray-500 uppercase tracking-wider">
              Verification Checkpoints
            </h4>
            {checks.map((c, i) => (
              <div 
                key={i} 
                className="p-3 rounded-lg border border-gray-200 bg-white flex items-start space-x-3"
              >
                {c.passed ? (
                  <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" />
                ) : (
                  <AlertTriangle className="w-4 h-4 text-amber-600 flex-shrink-0 mt-0.5" />
                )}
                <div className="flex-1">
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-bold text-gray-900">{c.title}</span>
                    {c.critical && (
                      <span className="text-[10px] bg-gray-100 text-gray-600 px-1.5 py-0.5 rounded font-mono">
                        Critical
                      </span>
                    )}
                  </div>
                  <p className="text-xs text-gray-500 mt-0.5">{c.detail}</p>
                </div>
              </div>
            ))}
          </div>

          {/* Dialogue Excerpt */}
          <div>
            <h4 className="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
              Audited Verbatim Lines
            </h4>
            <div className="bg-gray-50 p-3 rounded-lg border border-gray-200 space-y-1.5 text-xs">
