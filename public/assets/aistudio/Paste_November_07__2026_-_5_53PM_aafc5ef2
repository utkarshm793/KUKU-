          </div>
        </div>

        {/* Modal Footer */}
        <div className="p-4 bg-gray-50 border-t border-gray-100 flex items-center justify-end space-x-2">
          <button
            onClick={() => setActiveQCPromo(null)}
            className="px-4 py-2 bg-gray-900 text-white rounded-lg text-xs font-semibold hover:bg-gray-800 transition"
          >
            Close Audit
          </button>
        </div>
      </div>
    </div>
  );
};

