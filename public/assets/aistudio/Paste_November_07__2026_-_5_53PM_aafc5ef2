import { ScreenplayEpisode, PromoCandidate, ScoringWeights, QualityWarning } from '../types';
import { analyzeEpisodeHeuristic } from './heuristicEngine';

/**
 * Direct Gemini API structured microdrama promo discovery
 */
export async function analyzeEpisodeWithGemini(
  episode: ScreenplayEpisode,
  apiKey: string,
  modelName: 'gemini-1.5-flash' | 'gemini-1.5-pro' = 'gemini-1.5-flash',
  weights: ScoringWeights
): Promise<PromoCandidate[]> {
  if (!apiKey || apiKey.trim() === '') {
    // Graceful fallback to deterministic engine
    return analyzeEpisodeHeuristic(episode, weights);
  }

  const endpoint = `https://generativelanguage.googleapis.com/v1beta/models/${modelName}:generateContent?key=${apiKey}`;

  const prompt = `
You are the Lead Promo Intelligence Architect for Kuku's AI microdrama studio.
Analyze this timestamped screenplay for Episode ${episode.episodeNumber}: "${episode.title}".
Extract 1 to 3 non-overlapping promotional moments between 20 and 60 seconds duration for TikTok/Reels/Shorts.

RULES:
1. ONLY select exact timestamps that exist in the screenplay. DO NOT invent dialogue or scenes.
2. The promo must start with a high-impact hook in the first 3 seconds.
3. The promo must end on an unresolved, suspenseful cliffhanger or dramatic ultimatum.
4. It must be standalone and comprehensible to a first-time viewer.

SCREENPLAY TEXT:
${episode.rawText}

Respond ONLY with valid JSON following this schema:
[
  {
    "start_timestamp": "MM:SS.ms",
    "end_timestamp": "MM:SS.ms",
    "duration_seconds": 35,
    "hook": "Exact starting dialogue",
    "cliffhanger": "Exact ending line",
    "hook_score": 92,
    "cliffhanger_score": 94,
    "standalone_clarity": 88,
    "emotional_intensity": 90,
    "narrative_continuity": 85,
    "duration_suitability": 95,
    "reason": "Detailed creative reasoning why this creates a viral conversion funnel."
  }
]
`;

  try {
    const res = await fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        contents: [{ parts: [{ text: prompt }] }],
        generationConfig: {
          temperature: 0.2,
          responseMimeType: 'application/json'
        }
      })
    });

    if (!res.ok) {
      console.warn(`Gemini API returned status ${res.status}. Using heuristic engine.`);
      return analyzeEpisodeHeuristic(episode, weights);
    }

    const data = await res.json();
    const rawText = data.candidates?.[0]?.content?.parts?.[0]?.text;
    if (!rawText) throw new Error('No candidate response from Gemini');

    const parsedJson = JSON.parse(rawText);
    if (!Array.isArray(parsedJson)) throw new Error('Gemini did not return an array');

    return parsedJson.map((item: any, idx: number) => {
      const overall = Math.round(
        (item.hook_score || 80) * weights.openingHook +
        (item.cliffhanger_score || 80) * weights.cliffhanger +
        (item.standalone_clarity || 80) * weights.standaloneClarity +
        (item.emotional_intensity || 80) * weights.emotionalIntensity +
        (item.narrative_continuity || 80) * weights.narrativeContinuity +
        (item.duration_suitability || 80) * weights.durationSuitability
      );

      const warnings: QualityWarning[] = [];
      if ((item.duration_seconds || 30) < 20 || (item.duration_seconds || 30) > 60) {
        warnings.push({ code: 'DURATION_LIMIT', level: 'warning', message: 'AI candidate duration is outside 20-60s window.' });
      }

      // Collect dialogue snippets from episode matching range
      const matchingEvents = episode.events.filter(e => 
        e.startTimestamp >= item.start_timestamp && e.endTimestamp <= item.end_timestamp
      );

      return {
        id: `promo_ai_${episode.episodeNumber}_${idx}_${Date.now()}`,
        episode: episode.episodeNumber,
        episodeId: episode.id,
        start_timestamp: item.start_timestamp,
        end_timestamp: item.end_timestamp,
        start_seconds: episode.events.find(e => e.startTimestamp === item.start_timestamp)?.startSeconds || 0,
        end_seconds: episode.events.find(e => e.endTimestamp === item.end_timestamp)?.endSeconds || item.duration_seconds || 40,
        duration_seconds: item.duration_seconds || 35,
        hook: item.hook,
        cliffhanger: item.cliffhanger,
        dialogue_snippets: matchingEvents.length > 0 ? matchingEvents : episode.events.slice(0, 4),
        hook_score: item.hook_score || 85,
        cliffhanger_score: item.cliffhanger_score || 85,
        standalone_clarity: item.standalone_clarity || 85,
        emotional_intensity: item.emotional_intensity || 85,
        narrative_continuity: item.narrative_continuity || 85,
        duration_suitability: item.duration_suitability || 85,
        overall_score: overall,
        reason: item.reason || 'Strong emotional cliffhanger and rapid hook identified by Gemini LLM.',
        quality_warnings: warnings,
        review_status: 'Pending',
        discovery_engine: modelName
      };
    });
  } catch (err) {
    console.warn('Gemini request failed or format error:', err);
    return analyzeEpisodeHeuristic(episode, weights);
  }
}

