                    <span className="text-[10px] text-gray-400">/100</span>
                  </td>
                  <td className="p-4 max-w-md">
                    <p className="truncate text-gray-900 font-medium"><strong>H:</strong> {promo.hook}</p>
                    <p className="truncate text-gray-500 text-[11px] mt-0.5"><strong>C:</strong> {promo.cliffhanger}</p>
                  </td>
                  <td className="p-4">
                    <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold ${
                      promo.review_status === 'Approved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                      promo.review_status === 'Rejected' ? 'bg-rose-50 text-rose-700 border border-rose-200' :
                      'bg-gray-100 text-gray-600 border border-gray-200'
                    }`}>
                      {promo.review_status}
                    </span>
                  </td>
                  <td className="p-4 text-right">
                    <div className="flex items-center justify-end space-x-1.5">
                      <button
                        onClick={() => updatePromoStatus(promo.id, 'Approved')}
                        className={`p-1.5 rounded-md border ${
                          promo.review_status === 'Approved' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-white text-gray-500 border-gray-200 hover:text-emerald-600'
                        }`}
                        title="Approve"
                      >
                        <Check className="w-3.5 h-3.5" />
                      </button>
                      <button
                        onClick={() => updatePromoStatus(promo.id, 'Rejected')}
                        className={`p-1.5 rounded-md border ${
                          promo.review_status === 'Rejected' ? 'bg-rose-600 text-white border-rose-600' : 'bg-white text-gray-500 border-gray-200 hover:text-rose-600'
                        }`}
                        title="Reject"
